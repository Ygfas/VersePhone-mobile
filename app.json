{
  "expo": {

    "name": "versephone",
    "slug": "versephone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-verse.png",
    "scheme": "testreactnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.versephone.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-verse.png",
          "imageWidth": 120
        }
      ],
      "expo-video",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "Google_client_auth": "56321620017-urs0kl8hr0lghilh2h6sie3o51s3pijv.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "7cbaffed-d8ec-455c-8301-89ec1370c698"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
